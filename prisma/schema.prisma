generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model City {
  id                String  @id @default(cuid())
  name              String  @unique
  slug              String  @unique
  monumentImageUrl  String?

  leads        Lead[]
  instructors  Instructor[]
  drives       PlacementDrive[]
  batches      Batch[]
  contact      CityContact?
  eventOccurrences EventOccurrence[]

  createdAt DateTime @default(now())
}

model Lead {
  id            String   @id @default(cuid())
  name          String
  phone         String
  email         String
  qualification String
  city          City     @relation(fields: [cityId], references: [id])
  cityId        String
  createdAt     DateTime @default(now())
}

model HiringPartner {
  id      String @id @default(cuid())
  name    String
  logoUrl String?
  order   Int    @default(0)
}

model SuccessStory {
  id             String   @id @default(cuid())
  studentName    String
  avatarUrl      String?
  linkedinUrl    String?
  courseName     String
  roleLanded     String
  company        String
  companyLogoUrl String?
  description    String
  packageLabel   String
  order          Int      @default(0)
  createdAt      DateTime @default(now())
}

model Program {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  duration    String
  mode        String
  category    String
  description String
  bullets     String[]
  brochureUrl String?
  certificateUrl String?
  order       Int      @default(0)

  certifications    Certification[]
  curriculumModules CurriculumModule[]
  batches           Batch[]
  industryLeaderVisibility SectionVisibility[]
  addOnCertificates AddOnCertificate[]

  createdAt DateTime @default(now())
}

// A single add-on certificate PDF (e.g. an extra partner credential) that
// can be earned via more than one program — admin uploads it once and picks
// which programs it applies to, rather than re-uploading per program.
model AddOnCertificate {
  id       String    @id @default(cuid())
  name     String
  pdfUrl   String
  programs Program[]

  createdAt DateTime @default(now())
}

model Certification {
  id                  String  @id @default(cuid())
  name                String
  partnerInstitution  String
  brochureUrl         String
  program             Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId           String
}

model CurriculumModule {
  id        String  @id @default(cuid())
  title     String
  content   String
  order     Int     @default(0)
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId String
}

model JourneyStep {
  id          String @id @default(cuid())
  order       Int    @unique
  title       String
  description String
  icon        String @default("sparkles")
}

model Instructor {
  id              String   @id @default(cuid())
  name            String
  photoUrl        String?
  linkedinUrl     String?
  subjectTaught   String
  bio             String
  experienceYears Int
  tags            String[]
  isIndustryLeader Boolean @default(false)
  city            City     @relation(fields: [cityId], references: [id])
  cityId          String
  order           Int      @default(0)
  createdAt       DateTime @default(now())
}

model PlacementDrive {
  id       String   @id @default(cuid())
  company  String
  logoUrl  String?
  role     String
  city     City     @relation(fields: [cityId], references: [id])
  cityId   String
  date     DateTime
  createdAt DateTime @default(now())
}

model Batch {
  id                    String   @id @default(cuid())
  program               Program  @relation(fields: [programId], references: [id])
  programId             String
  startDate             DateTime
  applicationCloseDate  DateTime
  timing                String
  location              String
  city                  City     @relation(fields: [cityId], references: [id])
  cityId                String
  createdAt             DateTime @default(now())
}

model FaqCategory {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  icon  String @default("help-circle")
  order Int    @default(0)

  faqs Faq[]
}

model Faq {
  id         String      @id @default(cuid())
  question   String
  answer     String
  category   FaqCategory @relation(fields: [categoryId], references: [id])
  categoryId String
  order      Int         @default(0)
}

model SuggestedQuestion {
  id        String   @id @default(cuid())
  question  String
  askedBy   String?
  status    String   @default("pending") // pending | approved | dismissed
  createdAt DateTime @default(now())
}

model Event {
  id          String   @id @default(cuid())
  name        String
  description String
  isEnabled   Boolean  @default(false)
  occurrences EventOccurrence[]
  createdAt   DateTime @default(now())
}

model EventOccurrence {
  id            String   @id @default(cuid())
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId       String
  city          City     @relation(fields: [cityId], references: [id])
  cityId        String
  date          DateTime
  registrations EventRegistration[]
}

model EventRegistration {
  id           String          @id @default(cuid())
  occurrence   EventOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  occurrenceId String
  name         String
  phone        String
  createdAt    DateTime        @default(now())
}

model CityContact {
  id      String @id @default(cuid())
  city    City   @relation(fields: [cityId], references: [id])
  cityId  String @unique
  address String
  phone   String
  email   String
}

model SectionVisibility {
  id         String   @id @default(cuid())
  sectionKey String // e.g. "industry-leaders"
  program    Program? @relation(fields: [programId], references: [id])
  programId  String?
  isVisible  Boolean  @default(true)

  @@unique([sectionKey, programId])
}
