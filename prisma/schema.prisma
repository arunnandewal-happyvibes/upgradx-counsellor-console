generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model City {
  id                String  @id @default(cuid())
  name              String  @unique
  slug              String  @unique
  monumentImageUrl  String?

  leads        Lead[]
  instructors  Instructor[]
  drives       PlacementDrive[]
  batches      Batch[]
  contact      CityContact?
  eventOccurrences EventOccurrence[]

  createdAt DateTime @default(now())
}

model Lead {
  id            String   @id @default(cuid())
  name          String
  // Legacy fields from the original single-page form — kept nullable rather
  // than dropped so existing lead records aren't destroyed. The dynamic
  // swipe-through onboarding no longer asks for these.
  phone         String?
  email         String?
  qualification String?
  city          City?    @relation(fields: [cityId], references: [id])
  cityId        String?
  // Fields captured by the dynamic onboarding flow.
  graduation         String? // e.g. "B.Tech", or a custom-typed degree
  graduationCategory String? // "Tech" | "Non-Tech" — only meaningful for a custom degree
  cgpa               String?
  skills             String[]
  createdAt DateTime @default(now())
}

model HiringPartner {
  id      String @id @default(cuid())
  name    String
  logoUrl String?
  order   Int    @default(0)
}

model SuccessStory {
  id             String   @id @default(cuid())
  studentName    String
  avatarUrl      String?
  linkedinUrl    String?
  courseName     String
  roleLanded     String
  company        String
  companyLogoUrl String?
  description    String
  packageLabel   String
  order          Int      @default(0)
  createdAt      DateTime @default(now())
}

model Program {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  duration    String
  mode        String
  category    String
  description String
  bullets     String[]
  brochureUrl String?
  certificateUrl String?
  order       Int      @default(0)

  certifications    Certification[]
  curriculumModules CurriculumModule[]
  batches           Batch[]
  industryLeaderVisibility SectionVisibility[]
  addOnCertificates AddOnCertificate[]
  degreeRecChoice1  DegreeRecommendation[] @relation("DegreeRecChoice1")
  degreeRecChoice2  DegreeRecommendation[] @relation("DegreeRecChoice2")
  degreeRecChoice3  DegreeRecommendation[] @relation("DegreeRecChoice3")

  createdAt DateTime @default(now())
}

// One row per degree (matches the onboarding flow's degree tags, plus
// "Other" as the fallback bucket for a custom-typed degree). Admin-editable
// as a single spreadsheet-style table at /admin/recommendations — each
// degree recommends up to 3 programs with a short "why".
model DegreeRecommendation {
  id     String @id @default(cuid())
  degree String @unique
  order  Int    @default(0)

  choice1Program   Program? @relation("DegreeRecChoice1", fields: [choice1ProgramId], references: [id])
  choice1ProgramId String?
  choice1Why       String?

  choice2Program   Program? @relation("DegreeRecChoice2", fields: [choice2ProgramId], references: [id])
  choice2ProgramId String?
  choice2Why       String?

  choice3Program   Program? @relation("DegreeRecChoice3", fields: [choice3ProgramId], references: [id])
  choice3ProgramId String?
  choice3Why       String?
}

// Singleton row (there is only ever one) holding the copy shown on the
// console home hero when a student skips onboarding (no personalized
// profile to show recommendations for) — admin-editable at
// /admin/home-screen.
model HomeScreenSettings {
  id                     String   @id @default(cuid())
  headline               String   @default("can transform your journey") // shown after a fixed, brand-red "upGrad X" prefix
  subheadline            String   @default("Offline, mentor-led programs built with hiring partners — from classroom to career, in one connected track.")
  primaryCtaLabel        String   @default("Explore Programs")
  secondaryCtaLabel      String   @default("Book Counselling")
  placementRecordPercent String   @default("85%")
  placementRecordCaption String   @default("Avg. successful transitions within 6 months")
  careerGrowthCaption    String   @default("Tailored pathways for senior roles.")
  updatedAt              DateTime @updatedAt
}

// A single add-on certificate PDF (e.g. an extra partner credential) that
// can be earned via more than one program — admin uploads it once and picks
// which programs it applies to, rather than re-uploading per program.
model AddOnCertificate {
  id       String    @id @default(cuid())
  name     String
  pdfUrl   String
  programs Program[]

  createdAt DateTime @default(now())
}

model Certification {
  id                  String  @id @default(cuid())
  name                String
  partnerInstitution  String
  brochureUrl         String
  program             Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId           String
}

model CurriculumModule {
  id        String  @id @default(cuid())
  title     String
  content   String
  order     Int     @default(0)
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId String
}

model JourneyStep {
  id          String @id @default(cuid())
  order       Int    @unique
  title       String
  description String
  icon        String @default("sparkles")
}

model Instructor {
  id              String   @id @default(cuid())
  name            String
  photoUrl        String?
  linkedinUrl     String?
  subjectTaught   String
  bio             String
  experienceYears Int
  tags            String[]
  isIndustryLeader Boolean @default(false)
  city            City     @relation(fields: [cityId], references: [id])
  cityId          String
  order           Int      @default(0)
  createdAt       DateTime @default(now())
}

model PlacementDrive {
  id       String   @id @default(cuid())
  company  String
  logoUrl  String?
  role     String
  city     City     @relation(fields: [cityId], references: [id])
  cityId   String
  date     DateTime
  createdAt DateTime @default(now())
}

model Batch {
  id                    String   @id @default(cuid())
  program               Program  @relation(fields: [programId], references: [id])
  programId             String
  startDate             DateTime
  applicationCloseDate  DateTime
  timing                String
  location              String
  city                  City     @relation(fields: [cityId], references: [id])
  cityId                String
  createdAt             DateTime @default(now())
}

model FaqCategory {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  icon  String @default("help-circle")
  order Int    @default(0)

  faqs Faq[]
}

model Faq {
  id         String      @id @default(cuid())
  question   String
  answer     String
  category   FaqCategory @relation(fields: [categoryId], references: [id])
  categoryId String
  order      Int         @default(0)
}

model SuggestedQuestion {
  id        String   @id @default(cuid())
  question  String
  askedBy   String?
  status    String   @default("pending") // pending | approved | dismissed
  createdAt DateTime @default(now())
}

model Event {
  id          String   @id @default(cuid())
  name        String
  description String
  isEnabled   Boolean  @default(false)
  occurrences EventOccurrence[]
  createdAt   DateTime @default(now())
}

model EventOccurrence {
  id            String   @id @default(cuid())
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId       String
  city          City     @relation(fields: [cityId], references: [id])
  cityId        String
  date          DateTime
  registrations EventRegistration[]
}

model EventRegistration {
  id           String          @id @default(cuid())
  occurrence   EventOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  occurrenceId String
  name         String
  phone        String
  createdAt    DateTime        @default(now())
}

model CityContact {
  id      String @id @default(cuid())
  city    City   @relation(fields: [cityId], references: [id])
  cityId  String @unique
  address String
  phone   String
  email   String
}

model SectionVisibility {
  id         String   @id @default(cuid())
  sectionKey String // e.g. "industry-leaders"
  program    Program? @relation(fields: [programId], references: [id])
  programId  String?
  isVisible  Boolean  @default(true)

  @@unique([sectionKey, programId])
}

// Singleton row (there is only ever one) holding the editable content of the
// public Career Services & Placement Assistance Policy page. `body` uses a
// small line-based markup so the whole document can be edited in one
// textarea, matching the admin panel's existing "plain text with light
// syntax" convention (e.g. FAQ / curriculum forms) rather than a nested
// block-editor UI:
//   "## heading text"   -> section heading
//   "### heading text"  -> sub-heading
//   "**label**"         -> a standalone bold label line
//   "- item"            -> bullet list item (consecutive lines group into one list)
//   any other line      -> a paragraph
// Blank lines are ignored (purely for readability in the textarea).
model CareerServicesPolicy {
  id            String   @id @default(cuid())
  title         String   @default("Career Services & Placement Assistance Policy")
  version       String   @default("Version 1.0")
  effectiveDate String   @default("Effective Date: [DD/MM/YYYY]")
  body          String
  updatedAt     DateTime @updatedAt
}
