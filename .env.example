DATABASE_URL="postgresql://upgradx:upgradx@localhost:5432/upgradx?schema=public"

# Optional — Vercel Blob (add-on certificate uploads, admin image uploads, DB backups)
BLOB_READ_WRITE_TOKEN=""

# Optional — Resend (student "close session" summary email). Without these,
# closing a session still saves normally; only the email send is skipped.
RESEND_API_KEY=""
EMAIL_FROM="upGrad X <counselling@yourdomain.com>"

# Required for admin login (/admin/*). ADMIN_SESSION_SECRET should be a long
# random string, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# Optional — session voice transcription (speech-to-text). Free key at console.groq.com.
# Without it the "Record session" button simply doesn't appear. STT_BASE_URL can point at
# any OpenAI-compatible Whisper server (e.g. a self-hosted faster-whisper) instead of Groq.
GROQ_API_KEY=""
# STT_BASE_URL=""
# STT_MODEL="whisper-large-v3-turbo"

# Voice assistant language model — uses GROQ_API_KEY by default. Model names on free tiers
# change, so override here if one is retired. Any OpenAI-compatible host works.
# LLM_BASE_URL=""
# LLM_API_KEY=""
# LLM_MODEL="openai/gpt-oss-120b"
